# Copy to .env and adjust. .env is git-ignored.
# docker compose reads .env automatically. The application also imports it
# (spring.config.import=optional:file:.env[.properties]) when started from the repo root.
# Real environment variables always take precedence over values in this file.

POSTGRES_DB=pricingsim
POSTGRES_USER=pricingsim
POSTGRES_PASSWORD=pricingsim
# Host port published by docker compose. Change it if 5432 is already in use.
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Optional: full JDBC URL override. When unset, the application builds
# jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?reWriteBatchedInserts=true
# DB_URL=jdbc:postgresql://localhost:5432/pricingsim?reWriteBatchedInserts=true
